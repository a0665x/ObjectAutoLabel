# Enable only after setting a random secret of at least 32 characters.
OBJECT_AUTOLABEL_AUTH_ENABLED=false
# Real shell in the service container, for trusted operators only.
# The trusted local terminal is enabled by default; set false to disable it.
OBJECT_AUTOLABEL_CLI_ENABLED=true
OBJECT_AUTOLABEL_SESSION_SECRET=
# Exact browser-facing origin, for example https://device.example.com:8501
OBJECT_AUTOLABEL_PUBLIC_URL=

# Optional: preconfigure Ultralytics Platform dataset downloads.
# Users may instead enter a key temporarily in the Open Data page; it is never saved.
ULTRALYTICS_API_KEY=

# Register callback: <OBJECT_AUTOLABEL_PUBLIC_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Register callback: <OBJECT_AUTOLABEL_PUBLIC_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Register callback: <OBJECT_AUTOLABEL_PUBLIC_URL>/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
